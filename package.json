{
  "name": "@waberes/waberes-js",
  "version": "0.0.1",
  "type": "module",
  "description": "SDK for interacting with WABeres API for convenience",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm test && npm run build",
    "setup": "npm install && npm run build && npm link"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WABeres/waberes-js.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/WABeres/waberes-js/issues"
  },
  "homepage": "https://github.com/WABeres/waberes-js#readme",
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.7",
    "msw": "^2.14.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7",
    "zod": "^4.4.3"
  }
}
