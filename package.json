{
  "name": "waberes-js",
  "version": "0.1.0",
  "type": "module",
  "description": "SDK for interacting with WABeres API for convenience",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm test && npm run build",
    "setup": "npm install && npm run build && npm link"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WABeres/waberes-js.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/WABeres/waberes-js/issues"
  },
  "homepage": "https://github.com/WABeres/waberes-js#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "msw": "^2.14.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "zod": "^4.4.3"
  }
}
